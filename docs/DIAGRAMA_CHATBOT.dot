digraph G {rankdir=TB; graph [fontname="DejaVu Sans", bgcolor="white", nodesep=.35,ranksep=.38]; node [shape=box,style="rounded,filled",fillcolor="#eef4fa",color="#7992ae",fontname="DejaVu Sans",fontsize=11]; edge [fontname="DejaVu Sans",fontsize=10]; A[label="Inicio: privacidad y limites"]; B[label="Solicitar siguiente dato (8)"]; C[shape=diamond,label="Valido?"]; D[shape=diamond,label="3 intentos?"]; E[label="Explicar y reintentar"]; F[label="Derivar a tutoria y borrar datos",fillcolor="#fff0e5"]; G[shape=diamond,label="8 datos completos?"]; H[label="POST /predecir"]; I[shape=diamond,label="Respuesta de API valida?"]; J[label="Fallo del servicio: tutoria",fillcolor="#fff0e5"]; K[shape=diamond,label="Clase Dropout? "]; L[label="Explicar alerta y recomendar tutoria"]; M[label="Orientacion prudente"]; N[label="Borrar datos y finalizar",fillcolor="#e2f4eb"]; A->B; B->C; C->D[label="No"]; D->E[label="No"]; E->B; D->F[label="Si"]; C->G[label="Si"]; G->B[label="No"]; G->H[label="Si"]; H->I; I->J[label="No"]; I->K[label="Si"]; K->L[label="Si"]; K->M[label="No"]; L->N; M->N; J->N; F->N;}